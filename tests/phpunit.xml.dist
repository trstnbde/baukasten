<?xml version="1.0"?>
<phpunit
	bootstrap="bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	failOnRisky="true"
>
	<testsuites>
		<testsuite name="baukasten">
			<directory suffix=".php">./integration/</directory>
		</testsuite>
	</testsuites>
</phpunit>
