#. Description of the plugin
#: baukasten-new-tab.php
msgid "Turns one page into a browser start page: search with a choice of engines, a favourites bar, a greeting and a background, detached from the theme and without third-party requests."
msgstr ""

#. Author of the plugin
#: baukasten-new-tab.php
msgid "Torsten B."
msgstr ""

#. Author URI of the plugin
#: baukasten-new-tab.php
msgid "https://github.com/trstnbde"
msgstr ""

#: admin/views/settings-tab.php:37
msgid "A page of the site that works as the start page of a browser: search with a choice of engines, a favourites bar, a greeting and a background. It is served without the theme and makes no request to a third party, except when the background is set to photos from Unsplash."
msgstr ""

