#. translators: %s: search engine name.
#: includes/class-settings-tab.php:182
#, php-format
msgid "The shortcut of %s has to be up to eight letters or digits, different from the others."
msgstr "Das Kürzel von %s darf höchstens acht Buchstaben oder Ziffern haben und muss sich von den anderen unterscheiden."

#. translators: %s: search engine name.
#: includes/class-settings-tab.php:188
#, php-format
