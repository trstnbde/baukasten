msgstr "Beliebig"

#: admin/views/settings-tab.php:221
msgid "Application name"
msgstr "Anwendungsname"

#: admin/views/settings-tab.php:224
msgid "As registered at Unsplash; used as utm_source in the links to the photographer."
msgstr "Wie bei Unsplash registriert; wird als utm_source in den Links zum Fotografen verwendet."

#: admin/views/settings-tab.php:228
msgid "Change every"
msgstr "Wechseln alle"

#: admin/views/settings-tab.php:231
