msgstr "Quadratisch"

#: admin/views/settings-tab.php:265
msgid "Any"
msgstr "Beliebig"

#: admin/views/settings-tab.php:275
msgid "Application name"
msgstr "Anwendungsname"

#: admin/views/settings-tab.php:278
msgid "As registered at Unsplash; used as utm_source in the links to the photographer."
msgstr "Wie bei Unsplash registriert; wird als utm_source in den Links zum Fotografen verwendet."

#: admin/views/settings-tab.php:282
msgid "Change every"
msgstr "Wechseln alle"

#: admin/views/settings-tab.php:285
msgid "minutes"
msgstr "Minuten"

#: admin/views/settings-tab.php:286
msgid "0 changes the background only when the page is loaded. A hidden tab does not change."
msgstr "0 wechselt den Hintergrund nur beim Laden der Seite. Ein verborgener Tab wechselt nicht."

#: admin/views/settings-tab.php:292
#: templates/new-tab.php:64
msgid "Favourites"
msgstr "Favoriten"

#: admin/views/settings-tab.php:294
msgid "The bar at the top. What does not fit moves into the » menu. Icons are fetched by the server when saving and once a week, and served from this site; without one, the bar draws the first letter."
msgstr "Die Leiste oben. Was nicht passt, wandert ins »-Menü. Symbole holt der Server beim Speichern und einmal pro Woche und liefert sie von dieser Website aus; ohne Symbol zeigt die Leiste den ersten Buchstaben."

#: admin/views/settings-tab.php:299
#: admin/views/settings-tab.php:308
msgid "Title"
msgstr "Titel"

#: admin/views/settings-tab.php:301
#: admin/views/settings-tab.php:310
msgid "Icon address (optional)"
msgstr "Symbol-Adresse (optional)"

#: admin/views/settings-tab.php:302
msgid "Order"
msgstr "Reihenfolge"

#: admin/views/settings-tab.php:316
msgid "Add a favourite"
msgstr "Favorit hinzufügen"

#: admin/views/settings-tab.php:319
msgid "Save changes"
msgstr "Änderungen speichern"

#: admin/views/settings-tab.php:320
msgid "Save and test the Unsplash connection"
msgstr "Speichern und Unsplash-Verbindung testen"

#: admin/views/settings-tab.php:327
msgid "Empty the cache"
msgstr "Cache leeren"

#: admin/views/settings-tab.php:328
msgid "Forgets the Unsplash photo pool and the cached suggestions."
msgstr "Vergisst den Unsplash-Fotopool und die zwischengespeicherten Vorschläge."

