#. translators: %s: link to the Permalinks screen.
#: admin/views/settings-tab.php:46
#, php-format
msgid "This site uses plain permalinks, so cards have no short address. Choose a permalink structure on %s to give them one."
msgstr "Diese Website nutzt einfache Permalinks, deshalb haben Visitenkarten keine kurze Adresse. Wähle unter %s eine Permalink-Struktur, um ihnen eine zu geben."

#: admin/views/settings-tab.php:50
msgid "Settings, Permalinks"
msgstr "Einstellungen › Permalinks"

#: admin/views/settings-tab.php:59
