msgid "Add or rename categories with the <code>baukasten/consent/categories</code> filter."
msgstr "Kategorien lassen sich über den Filter <code>baukasten/consent/categories</code> ergänzen oder umbenennen."

#: admin/views/settings-tab.php:261
msgid "Assets on this site"
msgstr "Dateien dieser Website"

#: admin/views/settings-tab.php:265
msgid "Every front end page adds the scripts and stylesheets it printed to this list. Open the pages that matter — the home page, a post with an embed, the checkout — and the list fills itself."
msgstr "Jede Seite im Frontend ergänzt diese Liste um die Skripte und Stylesheets, die sie ausgegeben hat. Ruf die Seiten auf, auf die es ankommt – Startseite, ein Beitrag mit Embed, die Kasse – und die Liste füllt sich von selbst."

#: admin/views/settings-tab.php:274
msgid "Nothing recorded yet. Open the front end once and come back."
msgstr "Noch nichts erfasst. Ruf einmal das Frontend auf und komm zurück."

#: admin/views/settings-tab.php:280
msgid "Handle"
msgstr "Handle"

#: admin/views/settings-tab.php:281
msgid "Type"
msgstr "Typ"

#: admin/views/settings-tab.php:282
msgid "Loaded from"
msgstr "Geladen von"

#: admin/views/settings-tab.php:302
msgid "Stylesheet"
msgstr "Stylesheet"

#: admin/views/settings-tab.php:303
msgid "Script"
msgstr "Skript"

