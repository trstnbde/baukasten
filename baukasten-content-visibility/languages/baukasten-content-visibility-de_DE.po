#: includes/class-admin-column.php:184
msgid "The visibility could not be saved. Please reload the page and try again."
msgstr "Die Sichtbarkeit konnte nicht gespeichert werden. Bitte lade die Seite neu und versuche es noch einmal."

#: includes/class-ajax.php:47
msgid "Your session has expired. Please reload the page."
msgstr "Deine Sitzung ist abgelaufen. Bitte lade die Seite neu."

#: includes/class-ajax.php:57
msgid "This content could not be found."
msgstr "Dieser Inhalt konnte nicht gefunden werden."

#: includes/class-ajax.php:64
msgid "Visibility cannot be set for this content type."
msgstr "Für diesen Inhaltstyp kann keine Sichtbarkeit gesetzt werden."

#: includes/class-ajax.php:71
msgid "You are not allowed to edit this content."
msgstr "Du bist nicht berechtigt, diesen Inhalt zu bearbeiten."

#: includes/class-ajax.php:82
msgid "Unknown visibility value."
msgstr "Unbekannter Sichtbarkeitswert."

#: includes/class-bulk-actions.php:68
msgid "Set visibility to public"
msgstr "Sichtbarkeit auf öffentlich setzen"

#: includes/class-bulk-actions.php:69
msgid "Set visibility to private"
msgstr "Sichtbarkeit auf privat setzen"

#. translators: %s: number of updated items.
#: includes/class-bulk-actions.php:146
#, php-format
msgid "Visibility updated for %s item."
msgid_plural "Visibility updated for %s items."
msgstr[0] "Sichtbarkeit für %s Eintrag aktualisiert."
msgstr[1] "Sichtbarkeit für %s Einträge aktualisiert."

#. translators: %s: number of skipped items.
#: includes/class-bulk-actions.php:158
#, php-format
msgid "%s item was skipped because you may not edit it."
msgid_plural "%s items were skipped because you may not edit them."
msgstr[0] "%s Eintrag wurde übersprungen, weil du ihn nicht bearbeiten darfst."
msgstr[1] "%s Einträge wurden übersprungen, weil du sie nicht bearbeiten darfst."

#: includes/class-frontend-guard.php:123
#: includes/class-frontend-guard.php:261
#: includes/class-frontend-guard.php:412
msgid "This content is available to logged-in users only."
msgstr "Dieser Inhalt ist nur für angemeldete Benutzer verfügbar."

#: includes/class-frontend-guard.php:124
msgid "Login required"
msgstr "Anmeldung erforderlich"

#: includes/class-frontend-guard.php:395
msgid "Invalid post ID."
msgstr "Ungültige Beitrags-ID."

#: includes/class-frontend-guard.php:414
msgid "Log in"
msgstr "Anmelden"

#: includes/class-meta-box.php:57
#: includes/class-settings-tab.php:77
msgid "Content Visibility"
msgstr "Sichtbarkeit"

#: includes/class-meta-box.php:85
msgid "Visible to everyone."
msgstr "Für alle sichtbar."

#: includes/class-meta-box.php:89
msgid "Visible to logged-in users only, regardless of role."
msgstr "Nur für angemeldete Benutzer sichtbar, unabhängig von der Rolle."

#: includes/class-settings-tab.php:102
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-settings-tab.php:124
msgid "Content Visibility is running, but its settings screen needs the Baukasten - Privacy Toolkit plugin. Install it to configure which post types the visibility switch applies to."
msgstr "Content Visibility läuft, aber die Einstellungsseite braucht das Plugin Baukasten - Privacy Toolkit. Installiere es, um festzulegen, für welche Inhaltstypen der Sichtbarkeitsschalter gilt."

#: includes/class-settings-tab.php:176
msgid "Settings saved."
msgstr "Einstellungen gespeichert."

#. translators: %s: number of entries.
#: includes/class-settings-tab.php:206
#, php-format
msgid "%s entry was marked public."
msgid_plural "%s entries were marked public."
msgstr[0] "%s Eintrag wurde auf öffentlich gesetzt."
msgstr[1] "%s Einträge wurden auf öffentlich gesetzt."

#: includes/class-settings-tab.php:243
msgid "You are not allowed to change these settings."
msgstr "Du hast keine Berechtigung, diese Einstellungen zu ändern."
