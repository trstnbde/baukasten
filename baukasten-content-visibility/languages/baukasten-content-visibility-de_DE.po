msgid "Make this content publicly visible"
msgstr "Diesen Inhalt öffentlich sichtbar machen"

#: includes/class-admin-column.php:182
msgid "Saving…"
msgstr "Wird gespeichert …"

#: includes/class-admin-column.php:183
#: includes/class-ajax.php:96
msgid "Visibility saved."
