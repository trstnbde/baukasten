#: includes/class-page-list.php:117
#, php-format
msgid "Front page (%s)"
msgstr "Startseite (%s)"

#: includes/class-settings-tab.php:73
msgid "Multi-Domain"
msgstr "Multi-Domain"

#: includes/class-settings-tab.php:98
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-settings-tab.php:117
msgid "Multi-Domain is routing, but its overview needs the Baukasten - Privacy Toolkit plugin. Domains can still be assigned in the page list."
msgstr "Multi-Domain routet, aber die Übersicht braucht das Plugin Baukasten - Privacy Toolkit. Domains lassen sich weiterhin in der Seitenübersicht zuordnen."

#: includes/class-settings-tab.php:142
msgid "You are not allowed to change these settings."
msgstr "Du hast keine Berechtigung, diese Einstellungen zu ändern."

