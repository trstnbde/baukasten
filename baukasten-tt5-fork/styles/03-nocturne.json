					"name": "Pill",
					"slug": "pill",
					"size": "8px"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"name": "Small",
					"slug": "sm",
					"shadow": "0 0 0 1px #3f424d"
				},
				{
					"name": "Medium",
					"slug": "md",
					"shadow": "0 0 0 1px #595d6c, 0 6px 18px rgba(0,0,0,0.55)"
				},
				{
					"name": "Large",
					"slug": "lg",
					"shadow": "0 0 0 1px #9397ab, 0 16px 40px rgba(0,0,0,0.65)"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "Tiny",
					"slug": "20",
					"size": "5.6px"
				},
				{
					"name": "X-Small",
					"slug": "30",
					"size": "8.4px"
				},
				{
