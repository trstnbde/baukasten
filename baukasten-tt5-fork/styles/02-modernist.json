				{
					"name": "Small",
					"slug": "sm",
					"shadow": "0 1px 2px color-mix(in srgb, #2d2b2b 14%, transparent)"
				},
				{
					"name": "Medium",
					"slug": "md",
					"shadow": "0 3px 10px color-mix(in srgb, #2d2b2b 16%, transparent)"
				},
				{
					"name": "Large",
					"slug": "lg",
					"shadow": "0 12px 32px color-mix(in srgb, #2d2b2b 22%, transparent)"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
