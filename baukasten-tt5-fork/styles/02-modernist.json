				},
				{
					"name": "XX-Large",
					"slug": "80",
					"size": "64px"
				}
			]
		},
		"custom": {
			"spacing": {
				"1": "4px"
			},
			"color": {
				"neutral": {
					"100": "#f8f4f4",
					"200": "#eae7e7",
					"300": "#d7d3d3",
					"400": "#bab6b6",
					"500": "#9b9797",
					"600": "#7d7979",
					"700": "#605d5d",
					"800": "#444141",
					"900": "#2d2b2b"
				},
				"accent": {
					"100": "#fff2ef",
					"200": "#ffe0d9",
					"300": "#ffc4b8",
					"400": "#ff9783",
					"500": "#ff563c",
					"600": "#dd2b0f",
					"700": "#ae1800",
					"800": "#7c1405",
					"900": "#4d170e"
				},
				"accent-2": {
					"100": "#fff2ef",
					"200": "#ffe0da",
					"300": "#ffc4b9",
					"400": "#ff9784",
					"500": "#ef6853",
					"600": "#c94b39",
					"700": "#9e3526",
					"800": "#71261b",
					"900": "#471d16"
				},
				"divider": "color-mix(in srgb, #201e1d 40%, transparent)"
			},
			"image": {
				"filter": "grayscale(1) contrast(1.08)",
				"blend": "normal"
			},
			"button": {
				"align": "left"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|archivo"
		},
		"blocks": {
			"core/separator": {
				"border": {
					"width": "0 0 2px 0"
				}
			},
			"core/table": {
				"css": "& th, & td { border-width: 0 0 1px 0; border-style: solid; padding: var(--wp--preset--spacing--20); text-align: left; } & th { font-size: var(--wp--preset--font-size--x-small); font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, currentColor 60%, transparent); border-color: var(--wp--custom--color--divider); border-bottom-width: 2px; } & td { border-color: var(--wp--custom--color--divider); } & tbody tr:hover { background: color-mix(in srgb, currentColor 4%, transparent); } & thead { border-bottom: 0; } & tfoot { border-top: 0; }"
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|archivo",
					"fontWeight": "800"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|archivo",
					"fontWeight": "800"
				}
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|archivo",
					"fontWeight": "800"
				}
			},
			"h6": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var:preset|font-family|archivo",
					"fontWeight": "800"
				}
			}
		}
	}
