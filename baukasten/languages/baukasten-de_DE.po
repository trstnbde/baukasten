#: admin/views/settings-page.php:27
msgid "Baukasten settings tabs"
msgstr "Baukasten-Einstellungs-Tabs"

#: features/consent-blocking-engine/admin/views/settings-tab.php:45
msgid "Everything below is blocked for every visitor, in every response, whether the page came from a cache or not. A small script in the browser reads the consent cookie afterwards and puts back what that visitor allowed."
msgstr "Alles Folgende wird für jeden Besucher in jeder Antwort blockiert – egal, ob die Seite aus einem Cache kam oder nicht. Ein kleines Skript im Browser liest danach das Consent-Cookie und gibt frei, was dieser Besucher erlaubt hat."

#: features/consent-blocking-engine/admin/views/settings-tab.php:55
msgid "This plugin blocks and records. It does not display a consent banner — that is the job of a theme or a separate addon, which writes the visitor's decision through the REST endpoint below."
msgstr "Dieses Plugin blockiert und protokolliert. Es zeigt kein Consent-Banner – das ist Aufgabe eines Themes oder eines weiteren Addons, das die Entscheidung über den REST-Endpunkt unten schreibt."

#: features/consent-blocking-engine/admin/views/settings-tab.php:68
msgid "What is blocked"
msgstr "Was blockiert wird"

#: features/consent-blocking-engine/admin/views/settings-tab.php:73
msgid "Measures"
msgstr "Maßnahmen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:76
#: features/consent-blocking-engine/includes/class-hardening.php:325
msgid "Blocking measures"
msgstr "Blocking-Maßnahmen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:80
msgid "Scripts that need consent"
msgstr "Skripte, die eine Zustimmung brauchen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:81
msgid "Stylesheets that need consent"
msgstr "Stylesheets, die eine Zustimmung brauchen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:82
msgid "ES modules, including Interactivity API blocks"
msgstr "ES-Module, einschließlich Blöcken der Interactivity API"

#: features/consent-blocking-engine/admin/views/settings-tab.php:83
msgid "dns-prefetch and preconnect hints to other hosts"
msgstr "dns-prefetch- und preconnect-Hinweise auf andere Hosts"

#: features/consent-blocking-engine/admin/views/settings-tab.php:84
msgid "Embedded content from other providers"
msgstr "Eingebettete Inhalte anderer Anbieter"

#: features/consent-blocking-engine/admin/views/settings-tab.php:85
msgid "Avatars from gravatar.com"
msgstr "Avatare von gravatar.com"

#: features/consent-blocking-engine/admin/views/settings-tab.php:86
msgid "The emoji script loaded from s.w.org"
msgstr "Das Emoji-Skript von s.w.org"

#: features/consent-blocking-engine/admin/views/settings-tab.php:90
msgid "Storing the IP address of a commenter in the database"
msgstr "Die IP-Adresse eines Kommentators in der Datenbank speichern"

#: features/consent-blocking-engine/admin/views/settings-tab.php:91
msgid "Speculative loading (prefetch and prerender rules)"
msgstr "Speculative Loading (Prefetch- und Prerender-Regeln)"

#: features/consent-blocking-engine/admin/views/settings-tab.php:92
msgid "Dashboard requests to api.wordpress.org (news widget, browser check)"
msgstr "Dashboard-Anfragen an api.wordpress.org (Nachrichten-Widget, Browser-Prüfung)"

#: features/consent-blocking-engine/admin/views/settings-tab.php:93
msgid "Warn in the dashboard when the site is not served over HTTPS"
msgstr "Im Dashboard warnen, wenn die Website nicht über HTTPS läuft"

#: features/consent-blocking-engine/admin/views/settings-tab.php:97
msgid "Hide the user list of the REST API from visitors who are not logged in"
msgstr "Benutzerliste der REST-API vor nicht angemeldeten Besuchern verbergen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:98
msgid "Answer author archives and ?author= with \"not found\""
msgstr "Autorenarchive und ?author= mit „nicht gefunden“ beantworten"

#: features/consent-blocking-engine/admin/views/settings-tab.php:99
msgid "Leave the author name and URL out of oEmbed responses"
msgstr "Autorname und Autor-URL aus oEmbed-Antworten entfernen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:100
msgid "Leave users out of the XML sitemap"
msgstr "Benutzer aus der XML-Sitemap herauslassen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:101
msgid "Switch off XML-RPC, the pingback header and the RSD link"
msgstr "XML-RPC, den Pingback-Header und den RSD-Link abschalten"

#: features/consent-blocking-engine/admin/views/settings-tab.php:102
msgid "Switch off application passwords"
msgstr "Anwendungspasswörter abschalten"

#: features/consent-blocking-engine/admin/views/settings-tab.php:103
msgid "Update every plugin and theme automatically, including ones installed later"
msgstr "Alle Plugins und Themes automatisch aktualisieren, auch künftig installierte"

#: features/consent-blocking-engine/admin/views/settings-tab.php:123
msgid "Always off"
msgstr "Immer aus"

#: features/consent-blocking-engine/admin/views/settings-tab.php:126
msgid "Measures that are not consent gated"
msgstr "Maßnahmen ohne Zustimmungsabfrage"

#: features/consent-blocking-engine/admin/views/settings-tab.php:143
msgid "Nothing above is consent gated. A commenter cannot usefully be asked whether their IP address may be written to the database, and nobody visits a dashboard to read WordPress.org news — so these are simply switched off."
msgstr "Nichts davon hängt an einer Zustimmung. Einen Kommentator sinnvoll zu fragen, ob seine IP-Adresse in die Datenbank darf, funktioniert nicht, und niemand ruft ein Dashboard auf, um WordPress.org-Nachrichten zu lesen — also bleibt das schlicht aus."

#: features/consent-blocking-engine/admin/views/settings-tab.php:153
#: features/consent-blocking-engine/admin/views/settings-tab.php:156
msgid "Site hardening"
msgstr "Härtung"

#: features/consent-blocking-engine/admin/views/settings-tab.php:173
msgid "The first four keep the name an administrator logs in with off the public site. Application passwords stay available unless switched off here, because integrations such as mobile apps depend on them."
msgstr "Die ersten vier halten den Namen, mit dem sich ein Administrator anmeldet, von der öffentlichen Website fern. Anwendungspasswörter bleiben verfügbar, solange du sie hier nicht abschaltest, weil Integrationen wie mobile Apps sie brauchen."

#: features/consent-blocking-engine/admin/views/settings-tab.php:183
msgid "Front end script"
msgstr "Frontend-Skript"

#: features/consent-blocking-engine/admin/views/settings-tab.php:193
msgid "Load the consent script and placeholder styles on every page"
msgstr "Consent-Skript und Platzhalter-Styles auf jeder Seite laden"

#: features/consent-blocking-engine/admin/views/settings-tab.php:197
msgid "By default they are only loaded on pages that load something from another host or contain an embed. Switch this on if a banner or another plugin expects the script everywhere."
msgstr "Standardmäßig werden sie nur auf Seiten geladen, die etwas von einem anderen Host laden oder eine Einbettung enthalten. Schalte das ein, wenn ein Banner oder ein anderes Plugin das Skript überall erwartet."

#: features/consent-blocking-engine/admin/views/settings-tab.php:207
msgid "Keep consent log entries"
msgstr "Einträge im Consent-Log aufbewahren"

#: features/consent-blocking-engine/admin/views/settings-tab.php:219
msgid "months"
msgstr "Monate"

#. translators: %s: minimum number of months.
#: features/consent-blocking-engine/admin/views/settings-tab.php:224
#, php-format
msgid "Older entries are deleted once a day. At least %s months: the consent cookie lasts twelve, and a decision has to stay provable for as long as it is in force."
msgstr "Ältere Einträge werden einmal täglich gelöscht. Mindestens %s Monate: Das Consent-Cookie gilt zwölf Monate, und eine Entscheidung muss so lange nachweisbar bleiben, wie sie gilt."

#: features/consent-blocking-engine/admin/views/settings-tab.php:234
msgid "Assets from other hosts"
msgstr "Dateien von anderen Hosts"

#: features/consent-blocking-engine/admin/views/settings-tab.php:253
msgid "A script or stylesheet loaded from a host other than this one is put in this category unless it is listed below. Anything served from this site counts as necessary."
msgstr "Ein Skript oder Stylesheet von einem anderen Host landet in dieser Kategorie, solange es unten nicht anders zugeordnet ist. Alles von dieser Website gilt als notwendig."

#: features/consent-blocking-engine/admin/views/settings-tab.php:263
msgid "Embeds"
msgstr "Embeds"

#: features/consent-blocking-engine/admin/views/settings-tab.php:277
msgid "Avatars"
msgstr "Avatare"

#: features/consent-blocking-engine/admin/views/settings-tab.php:291
msgid "Policy version"
msgstr "Fassung der Texte"

#: features/consent-blocking-engine/admin/views/settings-tab.php:303
msgid "Written into every logged decision. Change it whenever the wording of your banner or privacy policy changes, so consent given before and after can be told apart."
msgstr "Wird in jede protokollierte Entscheidung geschrieben. Ändere den Wert, sobald sich der Wortlaut von Banner oder Datenschutzerklärung ändert – dann lässt sich die Zustimmung davor und danach auseinanderhalten."

#: features/consent-blocking-engine/admin/views/settings-tab.php:314
msgid "Categories"
msgstr "Kategorien"

#: features/consent-blocking-engine/admin/views/settings-tab.php:319
#: features/consent-blocking-engine/admin/views/settings-tab.php:373
msgid "Category"
msgstr "Kategorie"

#: features/consent-blocking-engine/admin/views/settings-tab.php:320
msgid "Slug"
msgstr "Slug"

#: features/consent-blocking-engine/admin/views/settings-tab.php:331
msgid "always allowed"
msgstr "immer erlaubt"

#: features/consent-blocking-engine/admin/views/settings-tab.php:345
msgid "Add or rename categories with the <code>baukasten/consent/categories</code> filter."
msgstr "Kategorien lassen sich über den Filter <code>baukasten/consent/categories</code> ergänzen oder umbenennen."

#: features/consent-blocking-engine/admin/views/settings-tab.php:351
msgid "Assets on this site"
msgstr "Dateien dieser Website"

#: features/consent-blocking-engine/admin/views/settings-tab.php:355
msgid "Every front end page you open while logged in as an administrator adds the scripts and stylesheets it printed to this list. Open the pages that matter — the home page, a post with an embed, the checkout — and the list fills itself."
msgstr "Jede Frontend-Seite, die du als angemeldeter Administrator öffnest, trägt die Skripte und Stylesheets, die sie ausgegeben hat, in diese Liste ein. Öffne die wichtigen Seiten – die Startseite, einen Beitrag mit Einbettung, den Checkout – und die Liste füllt sich von selbst."

#: features/consent-blocking-engine/admin/views/settings-tab.php:364
msgid "Nothing recorded yet. Open the front end once and come back."
msgstr "Noch nichts erfasst. Ruf einmal das Frontend auf und komm zurück."

#: features/consent-blocking-engine/admin/views/settings-tab.php:370
msgid "Handle"
msgstr "Handle"

#: features/consent-blocking-engine/admin/views/settings-tab.php:371
msgid "Type"
msgstr "Typ"

#: features/consent-blocking-engine/admin/views/settings-tab.php:372
msgid "Loaded from"
msgstr "Geladen von"

#: features/consent-blocking-engine/admin/views/settings-tab.php:392
msgid "Stylesheet"
msgstr "Stylesheet"

#: features/consent-blocking-engine/admin/views/settings-tab.php:393
msgid "Script"
msgstr "Skript"

#: features/consent-blocking-engine/admin/views/settings-tab.php:399
msgid "this site"
msgstr "dieser Website"

#. translators: %s: category label.
#: features/consent-blocking-engine/admin/views/settings-tab.php:413
#, php-format
msgid "Default (%s)"
msgstr "Standard (%s)"

#: features/consent-blocking-engine/admin/views/settings-tab.php:431
#: features/consent-blocking-engine/admin/views/settings-tab.php:446
msgid "Cookie overview"
msgstr "Cookie-Übersicht"

#: features/consent-blocking-engine/admin/views/settings-tab.php:435
msgid "A place to keep the cookie list your privacy policy needs. Nothing reads it automatically — no site can be scanned reliably from the inside, and a wrong list is worse than none."
msgstr "Ein Platz für die Cookie-Liste, die deine Datenschutzerklärung braucht. Nichts liest sie automatisch aus – eine Website lässt sich von innen nicht zuverlässig scannen, und eine falsche Liste ist schlimmer als gar keine."

#. translators: %s: cookie name.
#: features/consent-blocking-engine/admin/views/settings-tab.php:453
#, php-format
msgid "This plugin sets exactly one cookie itself: %s, which holds the visitor's decision, an anonymous id and a timestamp for twelve months."
msgstr "Dieses Plugin setzt selbst genau ein Cookie: %s. Es enthält die Entscheidung des Besuchers, eine anonyme Kennung und einen Zeitstempel und läuft nach zwölf Monaten ab."

#: features/consent-blocking-engine/admin/views/settings-tab.php:459
#: features/content-visibility/admin/views/settings-tab.php:115
#: features/login-legal-pages/admin/views/settings-tab.php:298
msgid "Save settings"
msgstr "Einstellungen speichern"

#: features/consent-blocking-engine/admin/views/settings-tab.php:462
msgid "Privacy hardening"
msgstr "DSGVO-Härtung"

#: features/consent-blocking-engine/admin/views/settings-tab.php:466
msgid "Puts the whole site into a defensible default state in one go: closes comments and pings on every entry, writes the privacy related WordPress settings, empties the credentials on Settings → Connectors, turns on automatic updates for every installed plugin and theme, and switches on every blocking and hardening measure above. Safe to run again — each step reports whether it changed anything. It never runs on its own — not on activation, not on update — only from this button or the WP-CLI command."
msgstr "Bringt die ganze Website in einem Zug in einen vertretbaren Grundzustand: schließt Kommentare und Pings bei jedem Eintrag, setzt die datenschutzrelevanten WordPress-Einstellungen, leert die Zugangsdaten unter Einstellungen → Konnektoren, schaltet automatische Aktualisierungen für alle installierten Plugins und Themes ein und aktiviert alle Blocking- und Härtungsmaßnahmen oben. Mehrfaches Ausführen ist unbedenklich – jeder Schritt meldet, ob er etwas geändert hat. Die Routine läuft nie von selbst – weder bei der Aktivierung noch bei einem Update –, sondern nur über diesen Button oder den WP-CLI-Befehl."

#: features/consent-blocking-engine/admin/views/settings-tab.php:475
msgid "This changes the whole site, not just this plugin."
msgstr "Das ändert die gesamte Website, nicht nur dieses Plugin."

#: features/consent-blocking-engine/admin/views/settings-tab.php:477
msgid "Comments are closed everywhere, registration is switched off, search engines are asked not to index the site, every connector is disconnected, and every plugin and theme is set to update automatically. None of it is undone by deactivating this plugin."
msgstr "Kommentare werden überall geschlossen, die Registrierung wird abgeschaltet, Suchmaschinen werden gebeten, die Website nicht zu indexieren, alle Konnektoren werden getrennt, und alle Plugins und Themes werden automatisch aktualisiert. Nichts davon wird durch das Deaktivieren dieses Plugins rückgängig gemacht."

#: features/consent-blocking-engine/admin/views/settings-tab.php:487
msgid "Result of the last hardening run"
msgstr "Ergebnis des letzten Härtungslaufs"

#: features/consent-blocking-engine/admin/views/settings-tab.php:490
msgid "Step"
msgstr "Schritt"

#: features/consent-blocking-engine/admin/views/settings-tab.php:491
msgid "Result"
msgstr "Ergebnis"

#: features/consent-blocking-engine/admin/views/settings-tab.php:492
msgid "Detail"
msgstr "Detail"

#: features/consent-blocking-engine/admin/views/settings-tab.php:503
msgid "changed"
msgstr "geändert"

#: features/consent-blocking-engine/admin/views/settings-tab.php:504
msgid "no change"
msgstr "unverändert"

#: features/consent-blocking-engine/admin/views/settings-tab.php:518
msgid "This closes comments on every entry, asks search engines not to index the site, empties all connector credentials and turns on automatic updates for every plugin and theme. Continue?"
msgstr "Das schließt Kommentare bei jedem Eintrag, rät Suchmaschinen von der Indexierung ab, leert alle Konnektor-Zugangsdaten und schaltet automatische Aktualisierungen für alle Plugins und Themes ein. Fortfahren?"

#: features/consent-blocking-engine/admin/views/settings-tab.php:522
msgid "Apply privacy hardening and defaults"
msgstr "DSGVO-Härtung & Standardwerte anwenden"

#. translators: %s: WP-CLI command.
#: features/consent-blocking-engine/admin/views/settings-tab.php:527
#, php-format
msgid "The same routine runs from the command line as %s."
msgstr "Dieselbe Routine läuft auf der Kommandozeile als %s."

#: features/consent-blocking-engine/admin/views/settings-tab.php:534
msgid "Consent log"
msgstr "Consent-Protokoll"

#. translators: %s: number of rows.
#: features/consent-blocking-engine/admin/views/settings-tab.php:540
#, php-format
msgid "The log holds %s decisions. Every change writes a new row; nothing is ever overwritten, so the history can be reconstructed. It contains no IP address and no user id — only the random id from the visitor’s cookie, and each row is deleted once the retention period set above has passed."
msgstr "Das Log enthält %s Entscheidungen. Jede Änderung schreibt eine neue Zeile; nichts wird überschrieben, sodass sich der Verlauf nachvollziehen lässt. Es enthält keine IP-Adresse und keine Benutzer-ID – nur die zufällige ID aus dem Cookie des Besuchers, und jede Zeile wird gelöscht, sobald die oben eingestellte Aufbewahrungsfrist abgelaufen ist."

#: features/consent-blocking-engine/admin/views/settings-tab.php:548
msgid "Export before you delete this plugin."
msgstr "Exportiere vor dem Löschen dieses Plugins."

#: features/consent-blocking-engine/admin/views/settings-tab.php:550
msgid "Deleting it drops the log table, and with it the record you would need to demonstrate that consent was given."
msgstr "Beim Löschen wird die Protokolltabelle entfernt – und damit der Nachweis, dass eine Zustimmung vorlag."

#: features/consent-blocking-engine/admin/views/settings-tab.php:561
msgid "Export as CSV"
msgstr "Als CSV exportieren"

#: features/consent-blocking-engine/admin/views/settings-tab.php:562
msgid "Export as JSON"
msgstr "Als JSON exportieren"

#: features/consent-blocking-engine/admin/views/settings-tab.php:565
msgid "Maintenance"
msgstr "Wartung"

#: features/consent-blocking-engine/admin/views/settings-tab.php:570
msgid "Clear the asset list and scan"
msgstr "Asset-Liste leeren und scannen"

#: features/consent-blocking-engine/admin/views/settings-tab.php:573
msgid "Forgets every handle recorded so far and records every visitor’s page views for the next 30 minutes, not only yours. The categories you assigned are kept. Useful after removing a plugin whose handles are still listed."
msgstr "Vergisst alle bisher erfassten Handles und erfasst in den nächsten 30 Minuten die Seitenaufrufe aller Besucher, nicht nur deine. Die zugewiesenen Kategorien bleiben erhalten. Nützlich, nachdem du ein Plugin entfernt hast, dessen Handles noch aufgeführt sind."

#. translators: %s: time of day.
#: features/consent-blocking-engine/admin/views/settings-tab.php:584
#, php-format
msgid "A scan is running until %s."
msgstr "Ein Scan läuft bis %s."

#. translators: 1: provider host name, 2: consent category label.
#: features/consent-blocking-engine/includes/class-blocking-oembed.php:92
#, php-format
msgid "Content from %1$s is hidden until you allow the category “%2$s”."
msgstr "Inhalte von %1$s bleiben verborgen, bis du die Kategorie „%2$s“ erlaubst."

#: features/consent-blocking-engine/includes/class-blocking-oembed.php:131
msgid "Load content"
msgstr "Inhalt laden"

#. translators: %s: consent category label.
#: features/consent-blocking-engine/includes/class-blocking-oembed.php:135
#, php-format
msgid "Load and always allow “%s”"
msgstr "Laden und „%s“ künftig immer erlauben"

