msgid "Necessary"
msgstr "Notwendig"

#: features/consent-blocking-engine/includes/class-categories.php:67
msgid "Required for the site to work. Cannot be refused."
msgstr "Für den Betrieb der Website erforderlich. Kann nicht abgelehnt werden."

#: features/consent-blocking-engine/includes/class-categories.php:71
msgid "Functional"
msgstr "Funktional"

#: features/consent-blocking-engine/includes/class-categories.php:72
msgid "Embedded content, maps, fonts and other conveniences loaded from other providers."
msgstr "Eingebettete Inhalte, Karten, Schriften und andere Annehmlichkeiten, die von anderen Anbietern geladen werden."

#: features/consent-blocking-engine/includes/class-categories.php:76
msgid "Statistics"
msgstr "Statistik"

#: features/consent-blocking-engine/includes/class-categories.php:77
msgid "Measures how the site is used."
msgstr "Misst, wie die Website genutzt wird."

#: features/consent-blocking-engine/includes/class-categories.php:81
msgid "Marketing"
msgstr "Marketing"

#: features/consent-blocking-engine/includes/class-categories.php:82
msgid "Tracks visitors across sites to build advertising profiles."
msgstr "Verfolgt Besucher über Websites hinweg, um Werbeprofile zu bilden."

#: features/consent-blocking-engine/includes/class-hardening.php:113
msgid "Comments and pings on existing content"
msgstr "Kommentare und Pings bei bestehenden Inhalten"

#: features/consent-blocking-engine/includes/class-hardening.php:125
msgid "Already closed everywhere."
msgstr "Überall bereits geschlossen."

#. translators: %s: number of entries.
#: features/consent-blocking-engine/includes/class-hardening.php:144
#, php-format
msgid "%s entry closed."
msgid_plural "%s entries closed."
msgstr[0] "%s Eintrag geschlossen."
msgstr[1] "%s Einträge geschlossen."

#: features/consent-blocking-engine/includes/class-hardening.php:156
msgid "WordPress settings"
msgstr "WordPress-Einstellungen"

#: features/consent-blocking-engine/includes/class-hardening.php:173
msgid "All already set."
msgstr "Alle bereits gesetzt."

#: features/consent-blocking-engine/includes/class-hardening.php:194
msgid "Connectors"
msgstr "Konnektoren"

#: features/consent-blocking-engine/includes/class-hardening.php:197
